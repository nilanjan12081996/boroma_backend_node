{
  "info": {
    "name": "Boroma Fleet Management API",
    "description": "Complete Boroma Fleet API collection with separate folders for each module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehical_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "fitness_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "permit_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "driver_id",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Admin & Auth",
      "description": "Admin user listings and JWT token generator for testing",
      "item": [
        {
          "name": "Get all admins (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": ":{baseUrl}/admin/admins"
            }
          }
        },
        {
          "name": "Generate SUPERADMIN JWT token for testing (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": ":{baseUrl}/admin/generate-token"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"SUPERADMIN\",\n  \"email\": \"admin@boroma.com\",\n  \"id\": 1\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
