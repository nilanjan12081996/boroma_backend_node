{
  "info": {
    "_postman_id": "driver-collection-v1",
    "name": "Driver API",
    "description": "Collection for testing Driver CRUD and status toggle APIs in Boroma Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_id",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Generate Test Token (Superadmin)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/generate-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "generate-token"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set(\"token\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "1. Register Driver (Auto-generate Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driver_name\": \"Rajesh Kumar\",\n  \"driver_phone\": \"9876543210\",\n  \"driver_email\": \"rajesh.kumar@boroma.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/driver/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set(\"driver_id\", jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Register Driver (With Custom Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driver_name\": \"Amit Sharma\",\n  \"driver_phone\": \"9876543211\",\n  \"driver_email\": \"amit.sharma@boroma.com\",\n  \"password\": \"SecurePass@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/driver/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Get All Drivers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/driver/getAll",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "getAll"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array of drivers\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Get All Drivers Filtered (?status & ?search)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/driver/getAll?status=0&search=Rajesh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "getAll"
          ],
          "query": [
            {
              "key": "status",
              "value": "0"
            },
            {
              "key": "search",
              "value": "Rajesh"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Get Driver By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/driver/get/{{driver_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "get",
            "{{driver_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Update Driver Details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"driver_name\": \"Rajesh Kumar Singh\",\n  \"driver_email\": \"rajesh.singh@boroma.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/driver/update/{{driver_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "update",
            "{{driver_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Toggle Driver Status",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/driver/{{driver_id}}/toggle-status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "{{driver_id}}",
            "toggle-status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Delete Driver",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/driver/delete/{{driver_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "driver",
            "delete",
            "{{driver_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}

